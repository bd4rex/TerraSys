# Copy this file to services/.env and replace the password before starting.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
NOMINATIM_PASSWORD=replace-with-another-long-random-local-password
# Bind only to a trusted LAN/VPN address when the host has public interfaces.
TERRASYS_BIND_ADDRESS=0.0.0.0
TERRASYS_HTTP_PORT=8080
# Linux starts the API with the invoking user's numeric identity. These defaults
# retain the image's non-root account when Compose is used without terrasys.sh.
TERRASYS_API_UID=10001
TERRASYS_API_GID=10001
# Blue-green shared-index updates manage these pointers automatically.
POSTGIS_VOLUME_NAME=services_terrasys_postgis_data
NOMINATIM_VOLUME_NAME=services_terrasys_nominatim_data
VALHALLA_DATA_PATH=../products/routing/valhalla
# The build command may replace this registry host after verifying the same digest.
OSM_CARTO_IMAGE=overv/openstreetmap-tile-server@sha256:b6a79da39b6d0758368f7c62d22e49dd3ec59e78b194a5ef9dee2723b1f3fa79
