# Large local map data and generated products
raw/
products/
tmp/
runtime/
backups/
offline-kit/
/tools/
qgis/
gao/

# GIS payloads should be rebuilt or downloaded, not committed.
*.osm.pbf
*.pmtiles
*.mbtiles
*.gpkg
*.sqlite
*.zip
*.gz

# Local generated web assets. Recreate with scripts/download-web-assets.ps1.
web/vendor/*
web/assets/glyphs/*
web/assets/sprites/*
web/styles/liberty/openfreemap-liberty.json

# Keep directory anchors.
!web/vendor/.gitkeep
!web/assets/glyphs/.gitkeep
!web/assets/sprites/.gitkeep
!web/styles/
!web/styles/liberty/
!web/styles/liberty/.gitkeep

# Local personal imports and media
data/photos/
data/imports/

# Python bytecode and local caches
__pycache__/
*.py[cod]
data/basemaps/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Local credentials and generated service state
services/.env
data/media/
data/exports/
data/imports/
data/terrain-cache/
data/osm-carto-tiles/
data/maintenance/
data/restore-recovery/
